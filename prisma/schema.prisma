// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Agent {
  id           String   @id @default(cuid())
  name         String
  description  String?
  systemPrompt String?
  createdAt    DateTime @default(now())
}

model ContextDocument {
  id              String   @id @default(cuid())
  projectName     String
  moduleName      String
  markdownContent String
  tags            String   @default("[]")
  sourceType      String?
  notebookId      String?
  createdAt       DateTime @default(now())
  notebook        ContextNotebook? @relation(fields: [notebookId], references: [id], onDelete: Cascade)

  @@index([notebookId, createdAt])
}

model ContextNotebook {
  id        String            @id @default(cuid())
  title     String
  notes     String            @default("")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  documents ContextDocument[]

  @@index([updatedAt])
}

model ChatSession {
  id        String        @id @default(cuid())
  title     String        @default("Nueva conversación")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([createdAt])
  @@index([updatedAt])
}

model ChatMessage {
  id        String     @id @default(cuid())
  sessionId String
  role      String
  content   String
  provider  String?
  createdAt DateTime   @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([createdAt])
}

model AgentActionLog {
  id             String   @id @default(cuid())
  storyReference String?
  action         String
  status         String   @default("DRAFT")
  testCases      String
  syncResult     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  persistedCases TestCase[]

  @@index([createdAt])
  @@index([status, createdAt])
}

model Proposal {
  id            String   @id @default(uuid())
  title         String
  diff          String
  reviews       String   @default("{}")
  humanApproval String?
  approvedDiffHash String?
  approvedAt    DateTime?
  checkpoint    String?
  branch        String?
  applied       Boolean  @default(false)
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model RunnerExecution {
  id             String   @id @default(uuid())
  job            String   @default("lint")
  testPath       String?
  status         String   @default("pending")
  output         String?
  error          String?
  command        String?
  approvalId     String?
  exitCode       Int?
  durationMs     Int
  timedOut       Boolean  @default(false)
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  projectProfile String?
  bugs           Bug[]

  @@index([status, startedAt])
  @@index([approvalId])
}

model ActionApproval {
  id            String   @id @default(uuid())
  operation     String
  target        String
  contentHash   String
  status        String   @default("APPROVED")
  approvedAt    DateTime @default(now())
  expiresAt     DateTime
  startedAt     DateTime?
  completedAt   DateTime?
  resultSummary String?
  errorSummary  String?
  createdAt     DateTime @default(now())

  @@index([status, expiresAt])
  @@index([operation, target])
}

model EnvironmentVariable {
  id            String   @id @default(uuid())
  key           String   @unique
  value         String
  environments  String   @default("[]")
  projectId     String?  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Requirement {
  id                 String                @id @default(uuid())
  key                String?               @unique
  title              String
  description        String                @default("")
  acceptanceCriteria String                @default("[]")
  status             String                @default("DRAFT")
  origin             String                @default("LOCAL")
  externalProvider   String?
  externalId         String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  testCases          TestCaseRequirement[]

  @@index([status, updatedAt])
  @@index([origin, externalProvider, externalId])
}

model TestCase {
  id                String                @id @default(uuid())
  title             String
  description       String                @default("")
  category          String                @default("manual")
  gherkin           String                @default("")
  steps             String                @default("[]")
  status            String                @default("DRAFT")
  contextReferences String                @default("[]")
  contextNotebookId String?
  contentHash       String
  sourceActionLogId String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  sourceAction      AgentActionLog?        @relation(fields: [sourceActionLogId], references: [id], onDelete: SetNull)
  requirements      TestCaseRequirement[]
  suites            TestSuiteCase[]
  bugs              Bug[]

  @@index([status, updatedAt])
  @@index([sourceActionLogId])
}

model TestCaseRequirement {
  requirementId String
  testCaseId    String
  createdAt     DateTime  @default(now())
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  testCase      TestCase    @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@id([requirementId, testCaseId])
  @@index([testCaseId])
}

model TestPlan {
  id          String          @id @default(uuid())
  name        String
  description String          @default("")
  status      String          @default("DRAFT")
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  suites      TestPlanSuite[]

  @@index([status, updatedAt])
}

model TestSuite {
  id          String          @id @default(uuid())
  name        String
  description String          @default("")
  status      String          @default("DRAFT")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  plans       TestPlanSuite[]
  testCases   TestSuiteCase[]

  @@index([status, updatedAt])
}

model TestPlanSuite {
  testPlanId String
  testSuiteId String
  position   Int       @default(0)
  testPlan   TestPlan  @relation(fields: [testPlanId], references: [id], onDelete: Cascade)
  testSuite  TestSuite @relation(fields: [testSuiteId], references: [id], onDelete: Cascade)

  @@id([testPlanId, testSuiteId])
  @@index([testSuiteId])
}

model TestSuiteCase {
  testSuiteId String
  testCaseId  String
  position    Int       @default(0)
  testSuite   TestSuite @relation(fields: [testSuiteId], references: [id], onDelete: Cascade)
  testCase    TestCase  @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@id([testSuiteId, testCaseId])
  @@index([testCaseId])
}

model Bug {
  id               String          @id @default(uuid())
  title            String
  description      String          @default("")
  severity         String          @default("MEDIUM")
  status           String          @default("OPEN")
  stepsToReproduce String          @default("[]")
  expected         String          @default("")
  observed         String          @default("")
  testCaseId       String?
  runnerExecutionId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  testCase         TestCase?       @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  runnerExecution  RunnerExecution? @relation(fields: [runnerExecutionId], references: [id], onDelete: SetNull)

  @@index([status, severity, updatedAt])
  @@index([testCaseId])
  @@index([runnerExecutionId])
}