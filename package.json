{
  "name": "pulsestudio",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "usability:update": "node scripts/update-usability.mjs",
    "context:update": "node scripts/update-context.mjs && npm run usability:update",
    "dev": "npm run context:update && next dev",
    "dev:clean": "lsof -ti :3000 | xargs kill -9 2>/dev/null || true; rm -rf .next && npm install && npx prisma generate && npm run dev",
    "dev:open": "(sleep 3 && open -a \"Google Chrome\" http://localhost:3000 || open http://localhost:3000) & npm run dev:clean",
    "desktop:dev": "concurrently -k -n \"NEXT,DESKTOP\" -c \"cyan,magenta\" \"npm run dev\" \"electron .\"",
    "desktop:build": "npm run build && electron-builder",
    "electron": "electron .",
    "build": "npm run context:update && next build",
    "start": "next start",
    "lint": "npm run context:update && eslint",
    "db:push": "npm run context:update && prisma db push",
    "test:e2e": "playwright test"
  },
  "build": {
    "appId": "com.pulsestudio.desktop",
    "productName": "PulseStudio",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "default",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "directories": {
      "output": "dist-electron"
    }
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.83",
    "@ai-sdk/mcp": "^2.0.78",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^6.0.209",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "mammoth": "^1.13.0",
    "next": "16.4.2",
    "node-pty": "^1.1.0",
    "pdf-parse": "^1.1.4",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tiktoken": "^1.0.22",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "allure-playwright": "^3.13.0",
    "concurrently": "^10.0.6",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "mammoth": {
      "argparse": "2.0.1"
    }
  }
}
